<!-- RM.003 基础用例-SVG渐变填充：线性渐变（按钮控制应用/复位）/ 纯色填充 -->
<!-- 应用/复位通过 if 挂载/卸载带渐变的SVG实现，复位时显示灰色参考 -->
<div class="container">
  <div class="header">
    <text class="header-title">SVG渐变填充</text>
    <input type="button" value="返回" class="back-btn" onclick="goBack" />
  </div>

  <list class="content">
    <!-- 007 线性渐变：linearGradient 水平方向红到蓝 -->
    <list-item class="card">
      <text class="label">007线性渐变</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <defs>
            <linearGradient id="g1" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#ff0000"/>
              <stop offset="100%" stop-color="#0000ff"/>
            </linearGradient>
          </defs>
          <rect x="20" y="20" width="260" height="60" fill="url(#g1)"/>
        </svg>
      </div>
      <text class="expect">预期：矩形从左到右红→蓝平滑渐变，无断层或色带</text>
    </list-item>

    <!-- 008 纯色填充：单一颜色均匀填充 -->
    <list-item class="card">
      <text class="label">008纯色填充</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <rect x="20" y="20" width="260" height="60" fill="#44aa44"/>
        </svg>
      </div>
      <text class="expect">预期：绿色纯色均匀填充整个矩形，无渐变或杂色</text>
    </list-item>

    <!-- 009 垂直渐变：linearGradient 从上到下黄到紫 -->
    <list-item class="card">
      <text class="label">009垂直渐变</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <defs>
            <linearGradient id="g2" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#ffcc00"/>
              <stop offset="100%" stop-color="#6600ff"/>
            </linearGradient>
          </defs>
          <rect x="20" y="20" width="260" height="60" fill="url(#g2)"/>
        </svg>
      </div>
      <text class="expect">预期：矩形从上到下黄→紫平滑渐变，无断层或色带</text>
    </list-item>

    <!-- 010 对角渐变：linearGradient 从左上到右下青到红 -->
    <list-item class="card">
      <text class="label">010对角渐变</text>
      <div class="svg-item">
        <svg width="450" height="250" viewBox="0 0 300 200">
          <defs>
            <linearGradient id="g3" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#00ffcc"/>
              <stop offset="100%" stop-color="#ff0044"/>
            </linearGradient>
          </defs>
          <rect x="20" y="20" width="260" height="160" fill="url(#g3)"/>
        </svg>
      </div>
      <text class="expect">预期：矩形从左上到右下青→红平滑渐变，方向正确，无断层或色带</text>
    </list-item>

    <!-- 007 线性渐变（五色对角·正方形） -->
    <list-item class="card">
      <text class="label">011线性渐变（五色对角正方形）</text>
      <div class="svg-item">
        <svg width="450" height="220" viewBox="0 0 300 200">
          <defs>
            <!-- 左上 → 右下对角渐变，高对比度5种纯色 -->
            <linearGradient id="g5" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#0000ff"/>    <!-- 蓝色 -->
              <stop offset="25%" stop-color="#00cc00"/>  <!-- 绿色 -->
              <stop offset="50%" stop-color="#ffff00"/>   <!-- 黄色 -->
              <stop offset="75%" stop-color="#ff8800"/>  <!-- 橙色 -->
              <stop offset="100%" stop-color="#ff0000"/> <!-- 红色 -->
            </linearGradient>
          </defs>
          <!-- 正方形宽高相等 -->
          <rect x="60" y="10" width="180" height="180" fill="url(#g5)"/>
        </svg>
      </div>
      <text class="expect">预期：正方形沿左上至右下对角线蓝→绿→黄→橙→红依次平滑过渡，色彩区分清晰，过渡自然无断层、无明显色带</text>
    </list-item>

    <!-- 008 径向渐变：radialGradient 圆心向外红→蓝 -->
    <list-item class="card">
      <text class="label">012径向渐变</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <defs>
            <radialGradient id="rg1" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#ff0000"/>
              <stop offset="100%" stop-color="#0000ff"/>
            </radialGradient>
          </defs>
          <rect x="20" y="20" width="260" height="80" fill="url(#rg1)"/>
        </svg>
      </div>
      <text class="expect">预期：矩形从中心向外红→蓝径向渐变，过渡平滑无断层</text>
    </list-item>

    <!-- 009 径向渐变多stop：绿→黄→橙三色 -->
    <list-item class="card">
      <text class="label">013径向渐变多stop</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <defs>
            <radialGradient id="rg2" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#00cc00"/>
              <stop offset="50%" stop-color="#ffdd00"/>
              <stop offset="100%" stop-color="#ff4400"/>
            </radialGradient>
          </defs>
          <rect x="20" y="20" width="260" height="80" fill="url(#rg2)"/>
        </svg>
      </div>
      <text class="expect">预期：矩形从中心向外绿→黄→橙三色径向渐变，色彩区分清晰，过渡自然无断层</text>
    </list-item>

    <!-- 010 solidColor：纯色 paint server 引用 -->
    <list-item class="card">
      <text class="label">014 solidColor纯色填充</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <defs>
            <solidColor id="sc1" solid-color="#00aaff"/>
          </defs>
          <rect x="20" y="20" width="260" height="80" fill="url(#sc1)"/>
        </svg>
      </div>
      <text class="expect">预期：矩形被统一的天蓝色纯色填充，无渐变、无色差，solidColor 作为 paint server 正常生效</text>
    </list-item>

    <list-item class="tail-spacer"></list-item>
  </list>
</div>
