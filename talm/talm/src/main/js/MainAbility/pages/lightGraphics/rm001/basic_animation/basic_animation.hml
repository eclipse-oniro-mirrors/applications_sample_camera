<!-- RM.001 基础用例-SVG动画：透明度变化 / 旋转 / 缩放 / 平移 -->
<!-- SMIL 无暂停API：播放/停止通过 if 挂载/卸载动画版SVG实现，停止时显示静态帧 -->
<div class="container">
  <div class="header">
    <text class="header-title">SVG动画</text>
    <input type="button" value="返回" class="back-btn" onclick="goBack" />
  </div>

  <list class="content">
    <!-- 012透明度变化：animate opacity 1→0 循环（标准写法：animate嵌套在目标元素内） -->
    <list-item class="card">
      <text class="label">012透明度变化</text>
      <div class="svg-item">
        <svg width="450" height="120" viewBox="0 0 300 80" if="{{play13}}">
          <rect x="110" y="15" width="80" height="50" fill="#e53935">
            <animate attributeName="opacity" from="1" to="0" dur="2s" repeatCount="indefinite"/>
          </rect>
        </svg>
        <svg width="450" height="120" viewBox="0 0 300 80" if="{{!play13}}">
          <rect x="110" y="15" width="80" height="50" fill="#e53935"/>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{play13 ? '停止' : '播放'}}" class="btn" onclick="togglePlay('play13')" />
      </div>
      <text class="expect">预期：播放时红色矩形透明度从1到0平滑循环；停止时矩形静止显示且不消失</text>
    </list-item>

    <!-- 013旋转：animateTransform rotate 0→360 -->
    <list-item class="card">
      <text class="label">013旋转</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100" if="{{play14}}">
          <rect x="125" y="25" width="50" height="50" fill="#44cc44">
            <animateTransform attributeName="transform" type="rotate" from="0 150 50" to="360 150 50" dur="3s" repeatCount="indefinite"/>
          </rect>
        </svg>
        <svg width="450" height="150" viewBox="0 0 300 100" if="{{!play14}}">
          <rect x="125" y="25" width="50" height="50" fill="#44cc44"/>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{play14 ? '停止' : '播放'}}" class="btn" onclick="togglePlay('play14')" />
      </div>
      <text class="expect">预期：播放时绿色矩形持续旋转无跳变；停止时矩形静止且不消失</text>
    </list-item>

    <!-- 014缩放：animateTransform scale 1→0.3，g标签定位中心点，scale叠加到g的translate上实现中心缩放 -->
    <list-item class="card">
      <text class="label">014缩放</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100" if="{{play15}}">
          <g transform="translate(150,50)">
            <rect x="-25" y="-25" width="50" height="50" fill="#4488ff"/>
            <animateTransform attributeName="transform" type="scale" from="1" to="0.3" dur="2s" repeatCount="indefinite" additive="sum"/>
          </g>
        </svg>
        <svg width="450" height="150" viewBox="0 0 300 100" if="{{!play15}}">
          <g transform="translate(150,50)">
            <rect x="-25" y="-25" width="50" height="50" fill="#4488ff"/>
          </g>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{play15 ? '停止' : '播放'}}" class="btn" onclick="togglePlay('play15')" />
      </div>
      <text class="expect">预期：播放时蓝色矩形以中心为原点从1倍到0.3倍平滑缩放循环；停止时矩形静止且不消失</text>
    </list-item>

    <!-- 015平移：animateTransform translate 0 0→180 0 -->
    <list-item class="card">
      <text class="label">015平移</text>
      <div class="svg-item">
        <svg width="450" height="120" viewBox="0 0 300 80" if="{{play16}}">
          <circle cx="40" cy="40" r="20" fill="#ffaa00">
            <animateTransform attributeName="transform" type="translate" from="0 0" to="180 0" dur="2s" repeatCount="indefinite"/>
          </circle>
        </svg>
        <svg width="450" height="120" viewBox="0 0 300 80" if="{{!play16}}">
          <circle cx="40" cy="40" r="20" fill="#ffaa00"/>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{play16 ? '停止' : '播放'}}" class="btn" onclick="togglePlay('play16')" />
      </div>
      <text class="expect">预期：播放时橙色圆从左向右水平平移循环；停止时圆回到起点静止且不消失</text>
    </list-item>

    <!-- 016标准对比：标准 href='#id' 外部引用 vs 标准嵌套写法（两者均应正常渲染） -->
    <list-item class="card">
      <text class="label">016标准对比：href vs 嵌套animate</text>
      <div class="svg-item">
        <svg width="450" height="240" viewBox="0 0 400 160" if="{{play17}}">
          <!-- 左侧：标准 href='#id' 外部引用 -->
          <rect id="r-legacy" x="30" y="30" width="80" height="80" fill="#ff4444"/>
          <animate href="#r-legacy" attributeName="opacity" from="1" to="0" dur="2s" repeatCount="indefinite"/>
          <!-- 右侧：标准嵌套写法 -->
          <rect x="220" y="30" width="80" height="80" fill="#4488ff">
            <animate attributeName="opacity" from="1" to="0" dur="2s" repeatCount="indefinite"/>
          </rect>
          <text x="30" y="140" font-size="14" fill="#ffffff">左侧：href='#id' 外部引用</text>
          <text x="220" y="140" font-size="14" fill="#ffffff">右侧：嵌套animate（标准）</text>
        </svg>
        <svg width="450" height="240" viewBox="0 0 400 160" if="{{!play17}}">
          <rect x="30" y="30" width="80" height="80" fill="#ff4444"/>
          <rect x="220" y="30" width="80" height="80" fill="#4488ff"/>
          <text x="30" y="140" font-size="14" fill="#ffffff">左侧：href='#id' 外部引用</text>
          <text x="220" y="140" font-size="14" fill="#ffffff">右侧：嵌套animate（标准）</text>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{play17 ? '停止' : '播放'}}" class="btn" onclick="togglePlay('play17')" />
      </div>
      <text class="expect">预期：左侧红色矩形（href外部引用）与右侧蓝色矩形（嵌套animate标准）均同步透明度循环；两种写法渲染结果一致</text>
    </list-item>
    <!-- 017颜色动画：animateColor 红→蓝循环 -->
    <list-item class="card">
      <text class="label">017颜色动画</text>
      <div class="svg-item">
        <svg width="450" height="120" viewBox="0 0 300 80" if="{{play18}}">
          <rect x="110" y="15" width="80" height="50" fill="#ff0000">
            <animateColor attributeName="fill" from="#ff0000" to="#0000ff" dur="2s" repeatCount="indefinite"/>
          </rect>
        </svg>
        <svg width="450" height="120" viewBox="0 0 300 80" if="{{!play18}}">
          <rect x="110" y="15" width="80" height="50" fill="#ff0000"/>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{play18 ? '停止' : '播放'}}" class="btn" onclick="togglePlay('play18')" />
      </div>
      <text class="expect">预期：播放时红色矩形平滑过渡到蓝色并循环；停止时矩形静止且不消失</text>
    </list-item>

    <!-- 018沿路径运动：animateMotion 圆形沿路径运动 -->
    <list-item class="card">
      <text class="label">018沿路径运动</text>
      <div class="svg-item">
        <svg width="450" height="120" viewBox="0 0 300 80" if="{{play19}}">
          <path id="mpath" d="M20,40 L280,40" fill="none" stroke="#dddddd" stroke-width="2"/>
          <circle r="15" fill="#ffaa00">
            <animateMotion dur="2s" repeatCount="indefinite" path="M20,40 L280,40"/>
          </circle>
        </svg>
        <svg width="450" height="120" viewBox="0 0 300 80" if="{{!play19}}">
          <path d="M20,40 L280,40" fill="none" stroke="#dddddd" stroke-width="2"/>
          <circle cx="20" cy="40" r="15" fill="#ffaa00"/>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{play19 ? '停止' : '播放'}}" class="btn" onclick="togglePlay('play19')" />
      </div>
      <text class="expect">预期：播放时橙色圆沿水平路径从左向右运动并循环；停止时圆静止且不消失</text>
    </list-item>

    <!-- 019animateMotion + mpath：引用外部路径元素实现运动动画 -->
    <list-item class="card">
      <text class="label">019mpath外部路径引用</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100" xmlns:xlink="http://www.w3.org/1999/xlink" if="{{play20}}">
          <path id="motionPath" d="M20,50 Q80,10 140,50 T260,50" fill="none" stroke="#dddddd" stroke-width="2"/>
          <circle r="10" fill="#aa66cc">
            <animateMotion dur="2s" repeatCount="indefinite" rotate="auto">
              <mpath xlink:href="#motionPath"/>
            </animateMotion>
          </circle>
        </svg>
        <svg width="450" height="150" viewBox="0 0 300 100" if="{{!play20}}">
          <path d="M20,50 Q80,10 140,50 T260,50" fill="none" stroke="#dddddd" stroke-width="2"/>
          <circle cx="20" cy="50" r="10" fill="#aa66cc"/>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{play20 ? '停止' : '播放'}}" class="btn" onclick="togglePlay('play20')" />
      </div>
      <text class="expect">预期：播放时紫色圆沿波浪路径平滑运动并循环；mpath 正确引用外部路径；停止时圆静止且不消失</text>
    </list-item>

    <!-- 020g分组旋转动画：组内多元素统一旋转 -->
    <list-item class="card">
      <text class="label">020g分组旋转动画</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100" if="{{play21}}">
          <g>
            <rect x="100" y="20" width="40" height="40" fill="#4488ff"/>
            <circle cx="150" cy="40" r="15" fill="#ff4444"/>
            <text x="125" y="80" font-size="12" fill="#ffffff">group</text>
            <animateTransform attributeName="transform" type="rotate" from="0 130 40" to="360 130 40" dur="3s" repeatCount="indefinite"/>
          </g>
        </svg>
        <svg width="450" height="150" viewBox="0 0 300 100" if="{{!play21}}">
          <g>
            <rect x="100" y="20" width="40" height="40" fill="#4488ff"/>
            <circle cx="150" cy="40" r="15" fill="#ff4444"/>
            <text x="125" y="80" font-size="12" fill="#ffffff">group</text>
          </g>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{play21 ? '停止' : '播放'}}" class="btn" onclick="togglePlay('play21')" />
      </div>
      <text class="expect">预期：播放时组内矩形、圆形、文字作为一个整体围绕中心点旋转，元素间相对位置不变；停止时整体静止且不消失</text>
    </list-item>

    <list-item class="tail-spacer"></list-item>
  </list>
</div>
