<!-- RM.001 异常场景用例：属性值非法（类型错误、无法解析、非法命令） -->
<div class="container">
  <div class="header">
    <text class="header-title">异常场景-非法值容错</text>
    <input type="button" value="返回" class="back-btn" onclick="goBack" />
  </div>

  <list class="content">
    <!-- 030 fill 非法颜色字符串 -->
    <list-item class="card">
      <text class="label">030 fill 非法颜色</text>
      <div class="svg-item">
        <svg width="450" height="165" viewBox="0 0 420 110">
          <rect x="0" y="0" width="420" height="110" fill="#ffffff"/>
          <rect x="20" y="20" width="80" height="60" fill="abc"/>
          <text x="20" y="95" font-size="12" fill="#333333">fill=abc</text>
          <rect x="140" y="20" width="80" height="60" fill="#12345"/>
          <text x="140" y="95" font-size="12" fill="#333333">fill=#12345</text>
          <rect x="260" y="20" width="80" height="60" fill="#4488ff"/>
          <text x="260" y="95" font-size="12" fill="#333333">正常</text>
        </svg>
      </div>
      <text class="expect">预期：第三个蓝色矩形正常填充显示；fill="abc"非法关键字、fill="#12345"无效十六进制颜色，按SVG规则回退为不填充，矩形无填充色，渲染不崩溃</text>
    </list-item>

    <!-- 031 opacity 非法字符串 -->
    <list-item class="card">
      <text class="label">031 opacity 非法字符串</text>
      <div class="svg-item">
        <svg width="450" height="165" viewBox="0 0 420 110">
          <rect x="20" y="20" width="80" height="60" fill="#4488ff" opacity="abc"/>
          <text x="20" y="95" font-size="12" fill="#ffffff">opacity=abc</text>
          <rect x="140" y="20" width="80" height="60" fill="#4488ff" opacity="0.5"/>
          <text x="140" y="95" font-size="12" fill="#ffffff">opacity=0.5</text>
        </svg>
      </div>
      <text class="expect">预期：非法字符串被忽略或降级，左矩形显示为不透明1；中间正常半透明</text>
    </list-item>

    <!-- 032 stroke-width 非法字符串 -->
    <list-item class="card">
      <text class="label">032 stroke-width 非法字符串</text>
      <div class="svg-item">
        <svg width="450" height="165" viewBox="0 0 420 110">
          <line x1="20" y1="30" x2="180" y2="30" stroke="#ff4444" stroke-width="abc"/>
          <text x="20" y="55" font-size="12" fill="#ffffff">width=abc</text>
          <line x1="20" y1="75" x2="180" y2="75" stroke="#4488ff" stroke-width="4"/>
          <text x="20" y="100" font-size="12" fill="#ffffff">width=4</text>
        </svg>
      </div>
      <text class="expect">预期：下方蓝色线条stroke‑width=4正常绘制；上方stroke‑width="abc"为非法非数字值；使用该属性的初始默认值，不丢弃元素、不置为 0；渲染不崩溃</text>
    </list-item>

    <!-- 033 transform 非法函数 -->
    <list-item class="card">
      <text class="label">033 transform 非法函数</text>
      <div class="svg-item">
        <svg width="450" height="165" viewBox="0 0 420 110">
          <rect x="20" y="20" width="60" height="60" fill="#ffaa00" transform="fly(10)"/>
          <text x="20" y="95" font-size="12" fill="#ffffff">fly(10)</text>
          <rect x="140" y="20" width="60" height="60" fill="#4488ff" transform="translate(20,0)"/>
          <text x="140" y="95" font-size="12" fill="#ffffff">translate(20,0)</text>
        </svg>
      </div>
      <text class="expect">预期：非法变换函数被忽略，橙色矩形保持原位；蓝色正常平移</text>
    </list-item>

    <!-- 034 路径非法命令 -->
    <list-item class="card">
      <text class="label">034 路径非法命令</text>
      <div class="svg-item">
        <svg width="450" height="165" viewBox="0 0 420 110">
          <path d="M20,60 L100,60" fill="none" stroke="#4488ff" stroke-width="3"/>
          <path d="M120,60 X200,60" fill="none" stroke="#ff4444" stroke-width="3"/>
          <path d="M220,60 Z L300,60" fill="none" stroke="#44cc44" stroke-width="3"/>
          <text x="340" y="65" font-size="12" fill="#ffffff">OK</text>
        </svg>
      </div>
      <text class="expect">预期：非法命令 X 与 Z 前无 M 被忽略；蓝色基准线正常显示；绿色路径被降级；OK正常显示</text>
    </list-item>

    <!-- 035 文本 XML 特殊字符 -->
    <list-item class="card">
      <text class="label">035 文本 XML 特殊字符</text>
      <div class="svg-item">
        <svg width="450" height="165" viewBox="0 0 420 110">
          <rect x="0" y="0" width="420" height="110" fill="#ffffff"/>
          <text x="20" y="35" font-size="16" fill="#333333">&lt;tag&gt;test&amp;demo&lt;/tag&gt;</text>
          <text x="20" y="65" font-size="16" fill="#e53935">\"quote\"</text>
          <text x="20" y="90" font-size="14" fill="#4488ff">OK</text>
        </svg>
      </div>
      <text class="expect">预期：XML 实体正确解析显示；文本正常渲染；OK 正常显示</text>
    </list-item>

    <!-- 036 translate 动画坐标包含 NaN 非法数值：值就是错的 -->
    <list-item class="card">
      <text class="label">036 translate 动画含 NaN</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 420 140" if="{{play31}}">
          <rect id="rect5" x="40" y="60" width="60" height="60" fill="#9966dd"/>
          <animateTransform href="#rect5" attributeName="transform" type="translate" values="100,50;NaN,50;100,50" dur="3s" repeatCount="indefinite"/>
          <text x="40" y="125" font-size="13" fill="#ffffff">观察方块运动状态</text>
        </svg>
        <svg width="450" height="150" viewBox="0 0 420 140" if="{{!play31}}">
          <rect id="rect5" x="40" y="60" width="60" height="60" fill="#9966dd"/>
          <text x="40" y="125" font-size="13" fill="#ffffff">观察方块运动状态</text>
        </svg>
      </div>
      <div class="btn-row">
        <input type="button" value="{{play31 ? '停止' : '播放'}}" class="btn" onclick="togglePlay('play31')" />
      </div>
      <text class="expect">预期：非法数值点被忽略，紫色矩形静止无变化</text>
    </list-item>

    <list-item class="tail-spacer"></list-item>
  </list>
</div>
