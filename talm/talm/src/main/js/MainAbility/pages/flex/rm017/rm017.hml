<div class="container">
    <div class="top-bar">
        <input class="btn-back" type="button" value="返回" onclick="goBack" />
        <text class="scene-title">{{ "  1：Flex(350px,180px) 功能验证，子项(50px,50px)  "}}</text>
    </div>
    <div class="display-area">
    <!-- flex容器1：子项-width:50px，height:50px -->
        <div class="scene-box-flex-1" style="
                overflow: {{boxOverflow}};
                flex-wrap: {{flexWrap}};
                flex-direction: {{flexDirection}};
                justify-content: {{justifyContent}};
                align-items: {{alignItems}};
                "
                >
            <div class="item item0" style="
                    width: {{itemWidth}};
                    height: {{itemHeight}};
                    "><text>1</text></div>
            <div class="item item2" style="
                    width: {{itemWidth}};
                    height: {{itemHeight}};
                    "><text>2</text></div>
            <div class="item item3"><text>3</text></div>
            <div class="item item4" style="display: {{itemDisplay4to6}};"><text>4</text></div>
            <div class="item item5" style="display: {{itemDisplay4to6}};"><text>5</text></div>
            <div class="item item0" style="display: {{itemDisplay4to6}};
                    width: {{itemWidth}};
                    height: {{itemHeight}};
                    margin-left: {{itemMarginLeft}};
                    "><text>6</text></div>
            <div class="item item7" style="display: {{itemDisplay}};"><text>7</text></div>
            <div class="item item8" style="display: {{itemDisplay}};"><text>8</text></div>
            <div class="item item0" style="display: {{itemDisplay}};
                    width: {{itemWidth}};
                    height: {{itemHeight}};
                    "><text>9</text></div>
            <div class="item item10" style="display: {{itemDisplay}};"><text>10</text></div>
            <div class="item item11" style="display: {{itemDisplay}};"><text>11</text></div>
        </div>

    <!-- flex容器2：子项-width:50px，height: -->
        <div class="scene-box-flex-2" style="display: {{displayFlex2}};
                overflow: {{boxOverflow}};
                flex-wrap: {{flexWrap}};
                flex-direction: {{flexDirection}};
                justify-content: {{justifyContent}};
                align-items: {{alignItems}};
                "
                >
            <div class="item-only-width item0" style="
                    height: {{ itemNoHeight }};
                    " ><text>1</text></div>
            <div class="item-only-width item2"><text>2</text></div>
            <div class="item-only-width item3"><text>3</text></div>
            <div class="item-only-width item4"><text>4</text></div>
            <div class="item-only-width item5"><text>5</text></div>
            <div class="item-only-width item6"><text>6</text></div>
            <div class="item-only-width item7"><text>7</text></div>
            <div class="item-only-width item0" style="
                    height: {{itemNoHeight}};
                    " ><text>8</text></div>
            <div class="item-only-width item9"><text>9</text></div>
            <div class="item-only-width item10"><text>10</text></div>
            <div class="item-only-width item11"><text>11</text></div>
        </div>
    <!-- flex容器3：子项-width:，height:50px -->
        <div class="scene-box-flex-3" style="display: {{displayFlex3}};
                overflow: {{boxOverflow}};
                flex-wrap: {{flexWrap}};
                flex-direction: {{flexDirection}};
                justify-content: {{justifyContent}};
                align-items: {{alignItems}};
                "
                >
            <div class="item-only-height item0" style="
                    width: {{ itemNoWidth }};
                    " ><text>1</text></div>
            <div class="item-only-height item2"><text>2</text></div>
            <div class="item-only-height item3"><text>3</text></div>
            <div class="item-only-height item4"><text>4</text></div>
            <div class="item-only-height item5"><text>5</text></div>
            <div class="item-only-height item6"><text>6</text></div>
            <div class="item-only-height item7"><text>7</text></div>
            <div class="item-only-height item0" style="
                    width: {{itemNoWidth}};
                    " ><text>8</text></div>
            <div class="item-only-height item9"><text>9</text></div>
            <div class="item-only-height item10"><text>10</text></div>
            <div class="item-only-height item11"><text>11</text></div>
        </div>
    </div>
    <div class="button-wrapper" clip="true">
        <list class="button-area" scrollbar="on">
        <!-- 子项控制 -->
            <list-item class="btn-item">
                <text class="group-label">子项大小设置：</text>
                <input class="btn btn-active" show="{{ idxItemWidth === 0 }}" type="button" onclick="setPropAndSelect('idxItemWidth', 0, 'width', '400px')" value="宽:400px"/>
                <input class="btn" show="{{ idxItemWidth !== 0 }}" type="button" onclick="setPropAndSelect('idxItemWidth', 0, 'width', '400px')" value="宽:400px"/>
                <input class="btn btn-active" show="{{ idxItemWidth === 1 }}" type="button" onclick="setPropAndSelect('idxItemWidth', 1, 'width', '30px')" value="宽:30px"/>
                <input class="btn" show="{{ idxItemWidth !== 1 }}" type="button" onclick="setPropAndSelect('idxItemWidth', 1, 'width', '30px')" value="宽:30px"/>
                <input class="btn btn-active" show="{{ idxItemWidth === 2 }}" type="button" onclick="setPropAndSelect('idxItemWidth', 2, 'width', '50px')" value="宽:50px"/>
                <input class="btn" show="{{ idxItemWidth !== 2 }}" type="button" onclick="setPropAndSelect('idxItemWidth', 2, 'width', '50px')" value="宽:50px"/>
                <input class="btn btn-active" show="{{ idxItemHeight === 0 }}" type="button" onclick="setPropAndSelect('idxItemHeight', 0, 'height', '250px')" value="高:250px"/>
                <input class="btn" show="{{ idxItemHeight !== 0 }}" type="button" onclick="setPropAndSelect('idxItemHeight', 0, 'height', '250px')" value="高:250px"/>
                <input class="btn btn-active" show="{{ idxItemHeight === 1 }}" type="button" onclick="setPropAndSelect('idxItemHeight', 1, 'height', '30px')" value="高:30px"/>
                <input class="btn" show="{{ idxItemHeight !== 1 }}" type="button" onclick="setPropAndSelect('idxItemHeight', 1, 'height', '30px')" value="高:30px"/>
                <input class="btn btn-active" show="{{ idxItemHeight === 2 }}" type="button" onclick="setPropAndSelect('idxItemHeight', 2, 'height', '50px')" value="高:50px"/>
                <input class="btn" show="{{ idxItemHeight !== 2 }}" type="button" onclick="setPropAndSelect('idxItemHeight', 2, 'height', '50px')" value="高:50px"/>
                <input class="btn btn-active" show="{{ idxNoHeight1 === 0 }}" type="button" onclick="setPropAndSelect('idxNoHeight1', 0, 'noHeight', '100px')" value="无高:100px"/>
                <input class="btn" show="{{ idxNoHeight1 !== 0 }}" type="button" onclick="setPropAndSelect('idxNoHeight1', 0, 'noHeight', '100px')" value="无高:100px"/>
                <input class="btn btn-active" show="{{ idxNoHeight1 === 1 }}" type="button" onclick="setPropAndSelect('idxNoHeight1', 1, 'noHeight', 'undefined')" value="无高:还原"/>
                <input class="btn" show="{{ idxNoHeight1 !== 1 }}" type="button" onclick="setPropAndSelect('idxNoHeight1', 1, 'noHeight', 'undefined')" value="无高:还原"/>
                <input class="btn btn-active" show="{{ idxNoWidth1 === 0 }}" type="button" onclick="setPropAndSelect('idxNoWidth1', 0, 'noWidth', '100px')" value="无宽:100px"/>
                <input class="btn" show="{{ idxNoWidth1 !== 0 }}" type="button" onclick="setPropAndSelect('idxNoWidth1', 0, 'noWidth', '100px')" value="无宽:100px"/>
                <input class="btn btn-active" show="{{ idxNoWidth1 === 1 }}" type="button" onclick="setPropAndSelect('idxNoWidth1', 1, 'noWidth', 'undefined')" value="无宽:还原"/>
                <input class="btn" show="{{ idxNoWidth1 !== 1 }}" type="button" onclick="setPropAndSelect('idxNoWidth1', 1, 'noWidth', 'undefined')" value="无宽:还原"/>
            </list-item>
        <!-- 显示/隐藏子项 -->
            <list-item class="btn-item">
                <text class="group-label">显示/隐藏：</text>
                <input class="btn btn-active" show="{{ idxItemDisplay === 0 }}" type="button" onclick="setPropAndSelect('idxItemDisplay', 0, 'itemDisplay', 'flex')" value="显示 7-11"/>
                <input class="btn" show="{{ idxItemDisplay !== 0 }}" type="button" onclick="setPropAndSelect('idxItemDisplay', 0, 'itemDisplay', 'flex')" value="显示 7-11"/>
                <input class="btn btn-active" show="{{ idxItemDisplay === 1 }}" type="button" onclick="setPropAndSelect('idxItemDisplay', 1, 'itemDisplay', 'none')" value="隐藏 7-11"/>
                <input class="btn" show="{{ idxItemDisplay !== 1 }}" type="button" onclick="setPropAndSelect('idxItemDisplay', 1, 'itemDisplay', 'none')" value="隐藏 7-11"/>
                <input class="btn btn-active" show="{{ idxItemDisplay4to6 === 0 }}" type="button" onclick="setPropAndSelect('idxItemDisplay4to6', 0, 'itemDisplay4to6', 'flex')" value="显示 4-6"/>
                <input class="btn" show="{{ idxItemDisplay4to6 !== 0 }}" type="button" onclick="setPropAndSelect('idxItemDisplay4to6', 0, 'itemDisplay4to6', 'flex')" value="显示 4-6"/>
                <input class="btn btn-active" show="{{ idxItemDisplay4to6 === 1 }}" type="button" onclick="setPropAndSelect('idxItemDisplay4to6', 1, 'itemDisplay4to6', 'none')" value="隐藏 4-6"/>
                <input class="btn" show="{{ idxItemDisplay4to6 !== 1 }}" type="button" onclick="setPropAndSelect('idxItemDisplay4to6', 1, 'itemDisplay4to6', 'none')" value="隐藏 4-6"/>
                <input class="btn btn-active" show="{{ idxDisplayFlex2 === 0 }}" type="button" onclick="setPropAndSelect('idxDisplayFlex2', 0, 'displayFlex2', 'flex')" value="显示flex2"/>
                <input class="btn" show="{{ idxDisplayFlex2 !== 0 }}" type="button" onclick="setPropAndSelect('idxDisplayFlex2', 0, 'displayFlex2', 'flex')" value="显示flex2"/>
                <input class="btn btn-active" show="{{ idxDisplayFlex2 === 1 }}" type="button" onclick="setPropAndSelect('idxDisplayFlex2', 1, 'displayFlex2', 'none')" value="隐藏flex2"/>
                <input class="btn" show="{{ idxDisplayFlex2 !== 1 }}" type="button" onclick="setPropAndSelect('idxDisplayFlex2', 1, 'displayFlex2', 'none')" value="隐藏flex2"/>
                <input class="btn btn-active" show="{{ idxDisplayFlex3 === 0 }}" type="button" onclick="setPropAndSelect('idxDisplayFlex3', 0, 'displayFlex3', 'flex')" value="显示flex3"/>
                <input class="btn" show="{{ idxDisplayFlex3 !== 0 }}" type="button" onclick="setPropAndSelect('idxDisplayFlex3', 0, 'displayFlex3', 'flex')" value="显示flex3"/>
                <input class="btn btn-active" show="{{ idxDisplayFlex3 === 1 }}" type="button" onclick="setPropAndSelect('idxDisplayFlex3', 1, 'displayFlex3', 'none')" value="隐藏flex3"/>
                <input class="btn" show="{{ idxDisplayFlex3 !== 1 }}" type="button" onclick="setPropAndSelect('idxDisplayFlex3', 1, 'displayFlex3', 'none')" value="隐藏flex3"/>
            </list-item>
        <!-- 溢出控制overflow -->
            <list-item class="btn-item">
                <text class="group-label">溢出控制：</text>
                <input class="btn btn-active" show="{{ idxOverflow === 0 }}" type="button" onclick="setPropAndSelect('idxOverflow', 0, 'overflow', 'visible')" value="visible"/>
                <input class="btn" show="{{ idxOverflow !== 0 }}" type="button" onclick="setPropAndSelect('idxOverflow', 0, 'overflow', 'visible')" value="visible"/>
                <input class="btn btn-active" show="{{ idxOverflow === 1 }}" type="button" onclick="setPropAndSelect('idxOverflow', 1, 'overflow', 'hidden')" value="hidden"/>
                <input class="btn" show="{{ idxOverflow !== 1 }}" type="button" onclick="setPropAndSelect('idxOverflow', 1, 'overflow', 'hidden')" value="hidden"/>
                <input class="btn btn-active" show="{{ idxOverflow === 2 }}" type="button" onclick="setPropAndSelect('idxOverflow', 2, 'overflow', '')" value="空字符串"/>
                <input class="btn" show="{{ idxOverflow !== 2 }}" type="button" onclick="setPropAndSelect('idxOverflow', 2, 'overflow', '')" value="空字符串"/>
                <input class="btn btn-active" show="{{ idxOverflow === 3 }}" type="button" onclick="setPropAndSelect('idxOverflow', 3, 'overflow', 'abc')" value="非法值"/>
                <input class="btn" show="{{ idxOverflow !== 3 }}" type="button" onclick="setPropAndSelect('idxOverflow', 3, 'overflow', 'abc')" value="非法值"/>
            <!-- 换行 flex-wrap -->
                <text class="group-label">换行 flex-wrap：</text>
                <input class="btn btn-active" show="{{ idxWrap === 0 }}" type="button" onclick="setPropAndSelect('idxWrap', 0, 'wrap', 'nowrap')" value="nowrap"/>
                <input class="btn" show="{{ idxWrap !== 0 }}" type="button" onclick="setPropAndSelect('idxWrap', 0, 'wrap', 'nowrap')" value="nowrap"/>
                <input class="btn btn-active" show="{{ idxWrap === 1 }}" type="button" onclick="setPropAndSelect('idxWrap', 1, 'wrap', 'wrap')" value="wrap"/>
                <input class="btn" show="{{ idxWrap !== 1 }}" type="button" onclick="setPropAndSelect('idxWrap', 1, 'wrap', 'wrap')" value="wrap"/>
            </list-item>
        <!-- margin-left（row布局容器外边距） -->
            <list-item class="btn-item">
                <text class="group-label">margin-left（row 容器）</text>
                <input class="btn btn-active" show="{{ idxMargin === 0 }}" type="button" onclick="setPropAndSelect('idxMargin', 0, 'margin', '-50px')" value="-50px"/>
                <input class="btn" show="{{ idxMargin !== 0 }}" type="button" onclick="setPropAndSelect('idxMargin', 0, 'margin', '-50px')" value="-50px"/>
                <input class="btn btn-active" show="{{ idxMargin === 1 }}" type="button" onclick="setPropAndSelect('idxMargin', 1, 'margin', '0px')" value="0px"/>
                <input class="btn" show="{{ idxMargin !== 1 }}" type="button" onclick="setPropAndSelect('idxMargin', 1, 'margin', '0px')" value="0px"/>
                <input class="btn btn-active" show="{{ idxMargin === 2 }}" type="button" onclick="setPropAndSelect('idxMargin', 2, 'margin', '50px')" value="50px"/>
                <input class="btn" show="{{ idxMargin !== 2 }}" type="button" onclick="setPropAndSelect('idxMargin', 2, 'margin', '50px')" value="50px"/>
                <input class="btn btn-active" show="{{ idxMargin === 3 }}" type="button" onclick="setPropAndSelect('idxMargin', 3, 'margin', 'auto')" value="auto"/>
                <input class="btn" show="{{ idxMargin !== 3 }}" type="button" onclick="setPropAndSelect('idxMargin', 3, 'margin', 'auto')" value="auto"/>
                <input class="btn btn-active" show="{{ idxMargin === 4 }}" type="button" onclick="setPropAndSelect('idxMargin', 4, 'margin', '')" value="空字符串"/>
                <input class="btn" show="{{ idxMargin !== 4 }}" type="button" onclick="setPropAndSelect('idxMargin', 4, 'margin', '')" value="空字符串"/>
                <input class="btn btn-active" show="{{ idxMargin === 5 }}" type="button" onclick="setPropAndSelect('idxMargin', 5, 'margin', 'abc')" value="非法值"/>
                <input class="btn" show="{{ idxMargin !== 5 }}" type="button" onclick="setPropAndSelect('idxMargin', 5, 'margin', 'abc')" value="非法值"/>
            </list-item>
        <!-- margin-left（row布局容器外边距） -->
            <list-item class="btn-item">
                <text class="group-label">margin-left 百分比（50% = 父高 × 50%）</text>
                <input class="btn btn-active" show="{{ idxMarginPct === 0 }}" type="button" onclick="setPropAndSelect('idxMarginPct', 0, 'margin', '-50%')" value="-50%"/>
                <input class="btn" show="{{ idxMarginPct !== 0 }}" type="button" onclick="setPropAndSelect('idxMarginPct', 0, 'margin', '-50%')" value="-50%"/>
                <input class="btn btn-active" show="{{ idxMarginPct === 1 }}" type="button" onclick="setPropAndSelect('idxMarginPct', 1, 'margin', '0%')" value="0%"/>
                <input class="btn" show="{{ idxMarginPct !== 1 }}" type="button" onclick="setPropAndSelect('idxMarginPct', 1, 'margin', '0%')" value="0%"/>
                <input class="btn btn-active" show="{{ idxMarginPct === 2 }}" type="button" onclick="setPropAndSelect('idxMarginPct', 2, 'margin', '50%')" value="50%"/>
                <input class="btn" show="{{ idxMarginPct !== 2 }}" type="button" onclick="setPropAndSelect('idxMarginPct', 2, 'margin', '50%')" value="50%"/>
            </list-item>
        <!-- 主轴方向 flex-direction -->
            <list-item class="btn-item">
                <text class="group-label">容器方向 flex-direction：</text>
                <input class="btn btn-active" show="{{ idxDir === 0 }}" type="button" onclick="setPropAndSelect('idxDir', 0, 'dir', 'row')" value="row"/>
                <input class="btn" show="{{ idxDir !== 0 }}" type="button" onclick="setPropAndSelect('idxDir', 0, 'dir', 'row')" value="row"/>
                <input class="btn btn-active" show="{{ idxDir === 1 }}" type="button" onclick="setPropAndSelect('idxDir', 1, 'dir', 'column')" value="column"/>
                <input class="btn" show="{{ idxDir !== 1 }}" type="button" onclick="setPropAndSelect('idxDir', 1, 'dir', 'column')" value="column"/>
                <input class="btn btn-active" show="{{ idxDir === 2 }}" type="button" onclick="setPropAndSelect('idxDir', 2, 'dir', '')" value="空字符串"/>
                <input class="btn" show="{{ idxDir !== 2 }}" type="button" onclick="setPropAndSelect('idxDir', 2, 'dir', '')" value="空字符串"/>
                <input class="btn btn-active" show="{{ idxDir === 3 }}" type="button" onclick="setPropAndSelect('idxDir', 3, 'dir', 'abc')" value="非法值"/>
                <input class="btn" show="{{ idxDir !== 3 }}" type="button" onclick="setPropAndSelect('idxDir', 3, 'dir', 'abc')" value="非法值"/>
            </list-item>
        <!-- 主轴对齐 justify-content -->
            <list-item class="btn-item">
                <text class="group-label">主轴对齐 justify-content：</text>
                <input class="btn btn-active" show="{{ idxMain === 0 }}" type="button" onclick="setPropAndSelect('idxMain', 0, 'main', 'flex-start')" value="flex-start"/>
                <input class="btn" show="{{ idxMain !== 0 }}" type="button" onclick="setPropAndSelect('idxMain', 0, 'main', 'flex-start')" value="flex-start"/>
                <input class="btn btn-active" show="{{ idxMain === 1 }}" type="button" onclick="setPropAndSelect('idxMain', 1, 'main', 'center')" value="center"/>
                <input class="btn" show="{{ idxMain !== 1 }}" type="button" onclick="setPropAndSelect('idxMain', 1, 'main', 'center')" value="center"/>
                <input class="btn btn-active" show="{{ idxMain === 2 }}" type="button" onclick="setPropAndSelect('idxMain', 2, 'main', 'flex-end')" value="flex-end"/>
                <input class="btn" show="{{ idxMain !== 2 }}" type="button" onclick="setPropAndSelect('idxMain', 2, 'main', 'flex-end')" value="flex-end"/>
                <input class="btn-larger btn-active" show="{{ idxMain === 3 }}" type="button" onclick="setPropAndSelect('idxMain', 3, 'main', 'space-between')" value="space-between"/>
                <input class="btn-larger" show="{{ idxMain !== 3 }}" type="button" onclick="setPropAndSelect('idxMain', 3, 'main', 'space-between')" value="space-between"/>
                <input class="btn-larger btn-active" show="{{ idxMain === 4 }}" type="button" onclick="setPropAndSelect('idxMain', 4, 'main', 'space-around')" value="space-around"/>
                <input class="btn-larger" show="{{ idxMain !== 4 }}" type="button" onclick="setPropAndSelect('idxMain', 4, 'main', 'space-around')" value="space-around"/>
                <input class="btn-larger btn-active" show="{{ idxMain === 5 }}" type="button" onclick="setPropAndSelect('idxMain', 5, 'main', 'space-evenly')" value="space-evenly"/>
                <input class="btn-larger" show="{{ idxMain !== 5 }}" type="button" onclick="setPropAndSelect('idxMain', 5, 'main', 'space-evenly')" value="space-evenly"/>
            </list-item>
        <!-- 交叉轴对齐 align-items -->
            <list-item class="btn-item">
                <text class="group-label">交叉轴对齐 align-items：</text>
                <input class="btn btn-active" show="{{ idxCross === 0 }}" type="button" onclick="setPropAndSelect('idxCross', 0, 'cross', 'flex-start')" value="flex-start"/>
                <input class="btn" show="{{ idxCross !== 0 }}" type="button" onclick="setPropAndSelect('idxCross', 0, 'cross', 'flex-start')" value="flex-start"/>
                <input class="btn btn-active" show="{{ idxCross === 1 }}" type="button" onclick="setPropAndSelect('idxCross', 1, 'cross', 'center')" value="center"/>
                <input class="btn" show="{{ idxCross !== 1 }}" type="button" onclick="setPropAndSelect('idxCross', 1, 'cross', 'center')" value="center"/>
                <input class="btn btn-active" show="{{ idxCross === 2 }}" type="button" onclick="setPropAndSelect('idxCross', 2, 'cross', 'flex-end')" value="flex-end"/>
                <input class="btn" show="{{ idxCross !== 2 }}" type="button" onclick="setPropAndSelect('idxCross', 2, 'cross', 'flex-end')" value="flex-end"/>
                <input class="btn btn-active" show="{{ idxCross === 3 }}" type="button" onclick="setPropAndSelect('idxCross', 5, 'cross', 'stretch')" value="stretch"/>
                <input class="btn" show="{{ idxCross !== 3 }}" type="button" onclick="setPropAndSelect('idxCross', 3, 'cross', 'stretch')" value="stretch"/>
            </list-item>
        <!-- 自动测试 -->
            <list-item class="btn-item">
                <text class="group-label">高频切换50次：</text>
                <input class="btn" type="button" onclick="stopAutoTest()" value="停止"/>
                <input class="btn-larger-bg btn-active" show="{{ isAutoOverflow }}" type="button" onclick="autoToggleOverflow()" value="overflow"/>
                <input class="btn-larger-bg" show="{{ !isAutoOverflow }}" type="button" onclick="autoToggleOverflow()" value="overflow"/>
                <input class="btn-larger-bg btn-active" show="{{ isAutoMargin }}" type="button" onclick="autoToggleMargin()" value="margin-left"/>
                <input class="btn-larger-bg" show="{{ !isAutoMargin }}" type="button" onclick="autoToggleMargin()" value="margin-left"/>
                <input class="btn-larger-bg btn-active" show="{{ isAutoWrap }}" type="button" onclick="autoFlexWrap()" value="flex-wrap"/>
                <input class="btn-larger-bg" show="{{ !isAutoWrap }}" type="button" onclick="autoFlexWrap()" value="flex-wrap"/>
                <input class="btn-larger-bg btn-active" show="{{ isAutoDir }}" type="button" onclick="autoFlexDir()" value="flex-direction"/>
                <input class="btn-larger-bg" show="{{ !isAutoDir }}" type="button" onclick="autoFlexDir()" value="flex-direction"/>
                <input class="btn-larger-bg btn-active" show="{{ isAutoMain }}" type="button" onclick="autoJustifyContent()" value="justify-content"/>
                <input class="btn-larger-bg" show="{{ !isAutoMain }}" type="button" onclick="autoJustifyContent()" value="justify-content"/>
                <input class="btn-larger-bg btn-active" show="{{ isAutoCross }}" type="button" onclick="autoAlignItems()" value="align-items"/>
                <input class="btn-larger-bg" show="{{ !isAutoCross }}" type="button" onclick="autoAlignItems()" value="align-items"/>
            </list-item>
            <list-item class="btn-item">
                <text class="group-label">重置：</text>
                <input class="btn-larger" type="button" onclick="resetAll()" value="重置全部参数"/>
            </list-item>
        </list>
    </div>
</div>
