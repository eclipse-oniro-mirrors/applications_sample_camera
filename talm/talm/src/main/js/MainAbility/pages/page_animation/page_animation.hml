<div class="container">
  <div class="top-bar">
    <input class="back-btn" type="button" value="返回" onclick="goBack" />
  </div>
  <list class="content" scrollbar="on">
    <list-item class="title-item">
      <text class="title">页面切换动效验证</text>
    </list-item>
    <list-item class="btn-item">
      <input class="btn" type="button" value="Fade 淡入淡出" onclick="goFade" />
    </list-item>
    <list-item class="btn-item">
      <input class="btn" type="button" value="Scale 缩放" onclick="goScale" />
    </list-item>
    <list-item class="btn-item">
      <input class="btn" type="button" value="双向滑动" onclick="goSlide" />
    </list-item>
    <list-item class="btn-item">
      <input class="btn" type="button" value="覆盖滑动" onclick="goOver" />
    </list-item>
    <list-item class="btn-item">
      <input class="btn" type="button" value="异常与边界" onclick="goEdge" />
    </list-item>
  </list>
</div>
