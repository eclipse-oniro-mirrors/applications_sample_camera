<!-- RM.009 过渡动画（透明度/缩放/旋转/颜色/位移/弹跳/串行/并行）测试 入口页：按用例分类导航 -->
<div class="container">
  <div class="header">
    <text class="header-title">过渡动画测试 RM.009</text>
    <input type="button" value="返回" class="back-btn" onclick="goBack" />
  </div>

  <!-- 用例分类列表，lite 小屏用 list+list-item 滚动 -->
  <list class="content">
    <list-item class="nav-item" onclick="navigateTo('basic')">
      <text class="nav-text">基础用例</text>
    </list-item>
    <list-item class="nav-item" onclick="navigateTo('boundary')">
      <text class="nav-text">边界约束用例</text>
    </list-item>
    <list-item class="nav-item" onclick="navigateTo('exception')">
      <text class="nav-text">异常场景用例</text>
    </list-item>

    <!-- 尾部占位：lite list 最后一项滚不到底，兜底 -->
    <list-item class="tail-spacer"></list-item>
  </list>
</div>
