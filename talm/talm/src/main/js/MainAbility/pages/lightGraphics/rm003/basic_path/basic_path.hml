<!-- RM.003 基础用例-SVG路径绘制：贝塞尔曲线/折线/弧线路径 -->
<div class="container">
  <div class="header">
    <text class="header-title">SVG路径绘制</text>
    <input type="button" value="返回" class="back-btn" onclick="goBack" />
  </div>

  <list class="content">
    <!-- 015 贝塞尔曲线：C 三次贝塞尔 + S 平滑接续 -->
    <list-item class="card">
      <text class="label">015 贝塞尔曲线</text>
      <div class="svg-item">
        <svg width="450" height="225" viewBox="0 0 200 150">
          <path d="M10,80 C40,10 65,10 95,80 S150,150 180,80" fill="none" stroke="#ff8800" stroke-width="3"/>
        </svg>
      </div>
      <text class="expect">预期：橙色平滑S形曲线，弯曲处无棱角或断裂</text>
    </list-item>

    <!-- 016 polyline 折线元素 -->
    <list-item class="card">
      <text class="label">016 polyline折线</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <polyline points="20,80 80,20 140,80 200,20 260,80" fill="none" stroke="#44aa44" stroke-width="3"/>
        </svg>
      </div>
      <text class="expect">预期：绿色锯齿折线，折点位置正确，线条不闭合</text>
    </list-item>

    <!-- 017 弧线路径：A圆弧指令拼接圆形 -->
    <list-item class="card">
      <text class="label">017 弧线路径</text>
      <div class="svg-item">
        <svg width="450" height="225" viewBox="0 0 200 150">
          <path d="M120,90 A30,30 0 1,1 180,90 A30,30 0 1,1 120,90" fill="#ff4488"/>
        </svg>
      </div>
      <text class="expect">预期：两段A圆弧指令拼接成完整粉色圆形，圆弧衔接位置无缺口、错位、变形</text>
    </list-item>

    <!-- 018 Path L指令折线（路径指令形式折线，区分polyline元素） -->
    <list-item class="card">
      <text class="label">018 Path折线(L指令)</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <path d="M20,20 L80,80 L140,20 L200,80 L260,20" fill="none" stroke="#aa66cc" stroke-width="3"/>
        </svg>
      </div>
      <text class="expect">预期：紫色折线，折点位置正确，线条连续不闭合、无断裂</text>
    </list-item>

    <!-- 019 水平线：H 指令 -->
    <list-item class="card">
      <text class="label">019 水平线</text>
      <div class="svg-item">
        <svg width="450" height="120" viewBox="0 0 300 80">
          <path d="M20,40 H280" fill="none" stroke="#ff4444" stroke-width="3"/>
        </svg>
      </div>
      <text class="expect">预期：红色水平线从左到右贯穿画布，无断裂</text>
    </list-item>

    <!-- 020 垂直线：V 指令 -->
    <list-item class="card">
      <text class="label">020 垂直线</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <path d="M150,20 V100" fill="none" stroke="#4488ff" stroke-width="3"/>
        </svg>
      </div>
      <text class="expect">预期：蓝色垂直线从上到下贯穿画布，无断裂</text>
    </list-item>

    <!-- 021 平滑二次贝塞尔：T 指令（连续曲线） -->
    <list-item class="card">
      <text class="label">021 平滑二次贝塞尔</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <path d="M20,60 Q60,20 100,60 T180,60 T260,60" fill="none" stroke="#aa66cc" stroke-width="3"/>
        </svg>
      </div>
      <text class="expect">预期：紫色连续二次贝塞尔波浪线平滑无断裂，各段衔接处切线连续</text>
    </list-item>

    <list-item class="tail-spacer"></list-item>
  </list>
</div>
