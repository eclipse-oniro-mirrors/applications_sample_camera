<!-- RM.003 基础用例-SVG基础形状绘制：矩形/椭圆/直线/多边形/圆角矩形/三角形 -->
<div class="container">
  <div class="header">
    <text class="header-title">SVG基础形状绘制</text>
    <input type="button" value="返回" class="back-btn" onclick="goBack" />
  </div>

  <list class="content">
    <!-- 001 矩形：rect 元素填充绘制 -->
    <list-item class="card">
      <text class="label">001 矩形</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <rect x="50" y="20" width="200" height="60" fill="#ff4444"/>
        </svg>
      </div>
      <text class="expect">预期：红色填充矩形完整显示，四角为直角，无圆角</text>
    </list-item>

    <!-- 002 椭圆：ellipse 元素，rx != ry 呈扁圆 -->
    <list-item class="card">
      <text class="label">002 椭圆</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <ellipse cx="150" cy="60" rx="100" ry="40" fill="#4444ff"/>
        </svg>
      </div>
      <text class="expect">预期：蓝色椭圆横扁显示（rx=100大于ry=40），边缘平滑，无锯齿</text>
    </list-item>

    <!-- 003 直线：line 元素按端点绘制 -->
    <list-item class="card">
      <text class="label">003 直线</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <line x1="20" y1="50" x2="280" y2="50" stroke="#ff8800" stroke-width="3"/>
        </svg>
      </div>
      <text class="expect">预期：一条橙色水平直线横穿画布，无断裂或缺口</text>
    </list-item>

    <!-- 004 多边形：polygon 顶点依次连线，五边形 -->
    <list-item class="card">
      <text class="label">004 多边形</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <polygon points="150,15 198,50 179,105 121,105 102,50" fill="#aa66cc"/>
        </svg>
      </div>
      <text class="expect">预期：紫色五边形完整闭合，五个顶点位置正确，边线无错位</text>
    </list-item>

    <!-- 005 圆角矩形：rect + rx/ry 圆角 -->
    <list-item class="card">
      <text class="label">005 圆角矩形</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <rect x="40" y="20" width="220" height="60" rx="15" ry="15" fill="#00aaaa"/>
        </svg>
      </div>
      <text class="expect">预期：青色矩形四角呈圆弧过渡（rx=ry=15），圆角大小均匀一致</text>
    </list-item>

    <!-- 006 三角形：polygon 三顶点闭合 -->
    <list-item class="card">
      <text class="label">006 三角形</text>
      <div class="svg-item">
        <svg width="450" height="150" viewBox="0 0 300 100">
          <polygon points="150,15 260,90 40,90" fill="#ff4488"/>
        </svg>
      </div>
      <text class="expect">预期：粉色三角形完整闭合，尖角朝上，三边连接无缺口</text>
    </list-item>
    <list-item class="tail-spacer"></list-item>
  </list>
</div>
