<!-- RM.001 基础用例-SVG组合绘制：多层叠加 / 同心圆颜色组合 -->
<div class="container">
  <div class="header">
    <text class="header-title">SVG组合绘制</text>
    <input type="button" value="返回" class="back-btn" onclick="goBack" />
  </div>

  <list class="content">
    <!-- 001 多层叠加：矩形+路径+圆形按文档顺序叠加，后定义者在上层 -->
    <list-item class="card">
      <text class="label">001 多层叠加</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <!-- 底层：矩形 -->
          <rect x="30" y="15" width="140" height="90" fill="#2196f3"/>
          <!-- 中层：路径三角形 -->
          <path d="M120,20 L190,100 L60,100 Z" fill="#ff9800"/>
          <!-- 顶层：圆形 -->
          <circle cx="150" cy="60" r="30" fill="#e53935"/>
        </svg>
      </div>
      <text class="expect">预期：蓝色矩形→橙色三角→红色圆逐层覆盖，遮挡关系与文档顺序一致</text>
    </list-item>

    <!-- 002 同心圆颜色组合：底色+4层同心圆，对应开发demo组合图形 -->
    <list-item class="card">
      <text class="label">002 同心圆颜色组合</text>
      <div class="svg-item">
        <svg width="450" height="300" viewBox="0 0 300 200">
          <circle cx="150" cy="100" r="90" fill="#ff4444"/>
          <circle cx="150" cy="100" r="60" fill="#44cc44"/>
          <circle cx="150" cy="100" r="35" fill="#4488ff"/>
          <circle cx="150" cy="100" r="15" fill="#ffcc00"/>
        </svg>
      </div>
      <text class="expect">预期：红/绿/蓝/黄4层同心圆圆心重合，各层颜色正确无串色，由内而外依次缩小</text>
    </list-item>
    <!-- 003 use元素引用：通过 defs 定义图形并由 use 复用实例化 -->
    <list-item class="card">
      <text class="label">003 use元素引用</text>
      <div class="svg-item">
        <svg width="450" height="200" viewBox="0 0 300 160">
          <defs>
            <rect id="baseRect" x="0" y="0" width="50" height="50" fill="#ff4444"/>
            <circle id="baseCircle" cx="25" cy="25" r="20" fill="#4488ff"/>
          </defs>
          <use href="#baseRect" x="20" y="20"/>
          <use href="#baseCircle" x="80" y="20"/>
          <use href="#baseRect" x="140" y="20" fill="#44cc44"/>
          <use href="#baseCircle" x="200" y="20" fill="#ffaa00"/>
        </svg>
      </div>
      <text class="expect">预期：四个图形（红矩形/蓝圆/绿矩形/黄圆）正常渲染，use 引用与直接定义图形渲染结果一致，覆盖属性（fill）生效</text>
    </list-item>

    <!-- 004 image元素：内嵌位图显示 -->
    <list-item class="card">
      <text class="label">004 image位图显示</text>
      <div class="svg-item">
        <svg width="450" height="200" viewBox="0 0 300 160">
          <rect x="20" y="20" width="120" height="120" fill="#eeeeee"/>
          <image x="25" y="25" width="110" height="110" href="common/icon.png"/>
          <text x="160" y="50" font-size="14" fill="#333333">原图参考</text>
          <image x="160" y="60" width="40" height="40" href="common/icon.png"/>
        </svg>
      </div>
      <text class="expect">预期：左侧大图与右侧小图均正常加载显示，位图按比例缩放，无拉伸变形或白边</text>
    </list-item>

    <list-item class="tail-spacer"></list-item>
  </list>
</div>
