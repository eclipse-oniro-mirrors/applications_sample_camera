<!-- RM.003 边界约束-SVG基础形状：属性值合法但超出正常范围（超大/超界/极大） -->
<div class="container">
  <div class="header">
    <text class="header-title">边界约束-尺寸与渐变超界</text>
    <input type="button" value="返回" class="back-btn" onclick="goBack" />
  </div>

  <list class="content">
    <!-- 022 超大尺寸：r=9999 与正常 r=30 对比 -->
    <list-item class="card">
      <text class="label">022超大尺寸</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <circle cx="150" cy="60" r="9999" fill="#4488ff"/>
          <circle cx="150" cy="60" r="1" fill="#ff4444"/>
        </svg>
      </div>
      <text class="expect">预期：蓝色大圆依靠 SVG 视口裁剪显示局部画面；中心可见微小红色圆点</text>
    </list-item>

    <!-- 023 圆角半径超大：rx=999 被钳制为胶囊形 -->
    <list-item class="card">
      <text class="label">023圆角半径超大</text>
      <div class="svg-item">
        <svg width="450" height="210" viewBox="0 0 300 140">
          <rect x="30" y="20" width="240" height="40" rx="20" ry="20" fill="#66bb6a"/>
          <rect x="30" y="80" width="240" height="40" rx="999" ry="999" fill="#ff9800"/>
        </svg>
      </div>
      <text class="expect">预期：上方绿色rx=20、ry=20为标准胶囊矩形；下方橙色rx、ry分别被钳制为width/2=120、height/2=20；rx远大于ry，图形两端横向圆角极大，视觉不是和上方一致的胶囊。</text>
    </list-item>

    <!-- 024 渐变 stop 偏移超界：offset=150% 与 -10% -->
    <list-item class="card">
      <text class="label">024渐变 stop 超界</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <defs>
            <linearGradient id="gOver1" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="150%" stop-color="#ff0000"/>
              <stop offset="100%" stop-color="#0000ff"/>
            </linearGradient>
            <linearGradient id="gOver2" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="-10%" stop-color="#00ff00"/>
              <stop offset="100%" stop-color="#ff00ff"/>
            </linearGradient>
          </defs>
          <rect x="20" y="20" width="120" height="40" fill="url(#gOver1)"/>
          <rect x="160" y="20" width="120" height="40" fill="url(#gOver2)"/>
          <text x="160" y="85" font-size="14" fill="#ffffff">OK</text>
        </svg>
      </div>
      <text class="expect">预期：越界offset自动clamp到0%‑100%。左侧offset=150%钳制为100%，左侧显示纯红色；右侧offset=-10%钳制为0%，产生绿色到品红色渐变；OK正常显示。</text>
    </list-item>

    <!-- 025 负半径、超大负坐标边界 -->
    <list-item class="card">
      <text class="label">025负半径与超大负坐标边界</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <!-- 圆形负半径 r=-10 -->
          <circle cx="70" cy="45" r="-10" fill="#ff4444"/>
          <text x="45" y="85" font-size="12" fill="#333333">circle r=-10</text>
          <!-- 矩形X超大负值 -->
          <rect x="-9999" y="30" width="80" height="60" fill="#4488ff"/>
          <text x="160" y="85" font-size="12" fill="#333333">rect x=-9999</text>
        </svg>
      </div>
      <text class="expect">预期：circle r=-10为非法数值回退r=0，圆形不绘制；rect x=-9999合法计算，图形位于视口外侧画布不可见</text>
    </list-item>

    <!-- 026 多stop组合 offset负值+超大值渐变边界 -->
    <list-item class="card">
      <text class="label">026多stop渐变offset越界组合边界</text>
      <div class="svg-item">
        <svg width="450" height="180" viewBox="0 0 300 120">
          <defs>
            <linearGradient id="gOverMulti" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="-20%" stop-color="#ff0000"/>
              <stop offset="40%" stop-color="#ffdd00"/>
              <stop offset="160%" stop-color="#0088ff"/>
            </linearGradient>
          </defs>
          <rect x="40" y="30" width="220" height="60" fill="url(#gOverMulti)"/>
        </svg>
      </div>
      <text class="expect">预期：offset‑20%、160%不会被clamp修改，分别落在渐变起点、终点外侧；矩形内部仅采样0%‑100%范围内色标，多色渐变正常渲染</text>
    </list-item>

    <list-item class="tail-spacer"></list-item>
  </list>
</div>
